msgstr "Falta un parámetro, el reclamo requiere un parámetro [%s] para estar presente."

#: beMessages.js:3
msgid "Missing comma(s), there should be exactly %d column at row \"%s\""
msgstr "Falta(n) coma(s), debe haber exactamente una columna %d en la fila \"%s\""

