msgstr "Lo sentimos, no podemos encontrar las respuestas a la puntuación. Por favor, contacta con tu administrador del sistema."

#: ../services/launchService.js:80
msgid "There are no responses to score yet. Please wait and try again."
msgstr "No hay respuestas para puntuar aún. Por favor, espera e inténtalo de nuevo."

#: ../services/launchService.js:84
msgid "Grading not available."
msgstr "Calificación no disponible."

#: ../services/launchService.js:85
msgid "Please contact your administrator."
msgstr "Por favor, póngase en contacto con su administrador."

#: ../services/launchService.js:94
#: ../services/launchService.js:106
#: ../services/launchService.js:118
#: ../services/launchService.js:163
msgid "No responses were found."
msgstr "No se encontraron respuestas."

#: ../services/launchService.js:95
msgid "Delivery executions with following ids cannot be found: <br><strong>%s</strong><br>Please contact your system administrator."
msgstr "No se encontraron ejecuciones de entrega con los siguientes identificadores: <br><strong>%s</strong><br>Comuníquese con el administrador del sistema."

#: ../services/launchService.js:107
msgid "Delivery executions with following ids are invalid: <br><strong>%s</strong><br>Please contact your system administrator."
msgstr "Las ejecuciones de entrega con los siguientes identificadores no son válidas: <br><strong>%s</strong><br>Comuníquese con el administrador del sistema."

#: ../services/launchService.js:119
msgid "Deliveries with following ids are invalid: <br><strong>%s</strong><br>Please contact your system administrator."
msgstr "Las entregas con los siguientes identificadores no son válidas: <br><strong>%s</strong><br>Comuníquese con el administrador del sistema."

#: ../services/launchService.js:129
msgid "Scoring is not available right now, because no responses were found."
msgstr "La puntuación no está disponible en este momento, porque no se encontraron respuestas."

#: ../services/launchService.js:130
msgid "This may happen if a student has just submitted the test. Please try again later. If the problem persists, please contact your system administrator. Test takers ids which were not found: <br><strong>%s</strong>"
msgstr "Esto puede ocurrir si un estudiante acaba de enviar la prueba. Por favor, inténtelo de nuevo más tarde. Si el problema persiste, póngase en contacto con el administrador del sistema. Id de los tomadores de pruebas que no fueron encontrados: <br><strong>%s</strong>"

#: ../services/launchService.js:140
msgid "Too many tasks to score."
msgstr "Demasiadas tareas para calificar."

#: ../services/launchService.js:142
msgid "Delivery execution ids: <strong>%s</strong><br>Number of scoring tasks: <strong>%s</strong><br>Allowed maximum number of tasks: <strong>%s</strong><br>Please contact your system administrator."
msgstr "Identificadores de ejecución de entrega: <strong>%s</strong><br>Número de tareas para calificar: <strong>%s</strong><br>Número máximo permitido de tareas: <strong>%s</strong><br>Comuníquese con el administrador del sistema."

#: ../services/launchService.js:149
msgid "Delivery ids: <strong>%s</strong><br>Test taker ids: <strong>%s</strong><br>Number of scoring tasks: <strong>%s</strong><br>Allowed maximum number of tasks: <strong>%s</strong><br>Please contact your system administrator."
msgstr "Identificadores de entrega: <strong>%s</strong><br>Identificadores de los candidatos: <strong>%s</strong><br>Número de tareas de calificación: <strong>%s</strong><br>Número máximo permitido de tareas: <strong>%s</strong><br>Comuníquese con el administrador del sistema."

#: ../services/launchService.js:164
msgid "Deliveries and test takers with following ids cannot be found.<br>Deliveries: <strong>%s</strong>, <br>Test takers: <strong>%s</strong>. <br>Please contact your system administrator."
msgstr "No se pueden encontrar las entregas y los tomadores de pruebas con los siguientes identificadores.<br>Entrega: <strong>%s</strong>, <br>Probadores: <strong>%s</strong>. <br>Póngase en contacto con el administrador del sistema."

#: ../services/launchService.js:176
msgid "Delivery ID(s) and Test Taker ID(s) are empty or not defined."
msgstr "Los identificadores de entrega y de los candidatos están vacíos o no están definidos."

#: ../services/launchService.js:181
msgid "Delivery ID(s) is empty or not defined."
msgstr "Los identificadores de entrega están vacíos o no están definidos."

#: ../services/launchService.js:186
msgid "Test Taker ID(s) is empty or not defined."
msgstr "El ID del candidato está vacío o no está definido"

#: ../services/launchService.js:191
msgid "Review failed: The reviewer cannot be the same user as the original scorer."
msgstr "Revisión fallida: El revisor no puede ser el mismo usuario que el marcador original."

#: ../services/launchService.js:192
msgid "Please assign a different reviewer to ensure an independent review of the score."
msgstr "Por favor asigne un revisor diferente para asegurar una revisión independiente de la puntuación."

#: ../services/launchService.js:196
msgid "Invalid Scoring Category"
msgstr "Categoría de puntuación no válida"

#: ../services/launchService.js:197
msgid "Please check the scoringCategory value. It must be valid and cannot be empty."
msgstr "Por favor, compruebe el valor de la categoría. Debe ser válido y no puede estar vacío."

#: ../services/launchService.js:201
msgid "Invalid custom claim."
msgstr "Reclamo personalizado inválido."

#: ../services/launchService.js:202
